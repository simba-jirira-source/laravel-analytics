{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simba-jirira-source/laravel-analytics",
    "description": "First-party, self-hosted application analytics for Laravel.",
    "type": "library",
    "keywords": [
        "analytics",
        "laravel",
        "laravel-analytics",
        "simba-jirira-source",
        "statistics",
        "tracking"
    ],
    "homepage": "https://github.com/simba-jirira-source/laravel-analytics",
    "license": "MIT",
    "authors": [
        {
            "name": "simba-jirira-source",
            "email": "github@simbajirira.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/simba-jirira-source/laravel-analytics/issues",
        "source": "https://github.com/simba-jirira-source/laravel-analytics"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/validation": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/agent-detector": "^2.0",
        "laravel/chisel": "^0.1",
        "laravel/pint": "^1.29",
        "laravel/prompts": "^0.3",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SimbaJirira\\LaravelAnalytics\\": "src/",
            "SimbaJirira\\LaravelAnalytics\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimbaJirira\\LaravelAnalytics\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "test:types": [
            "@php tools/type-coverage.php"
        ],
        "test:unit": [
            "@php tools/run-pest.php"
        ],
        "test:database": [
            "@php tools/run-pest.php tests/DatabaseIntegration"
        ],
        "security:audit": [
            "composer audit --format=plain --abandoned=ignore"
        ],
        "test": [
            "@prepare",
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "verify": [
            "composer validate --strict",
            "@security:audit",
            "@test"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimbaJirira\\LaravelAnalytics\\AnalyticsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
